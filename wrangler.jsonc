{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "edu-status-v2",
	"account_id": "daf707e0ad661fae6c714cfb1c4b4e2c",
	"workers_dev": true,
	"main": "server/worker.mjs",
	"compatibility_date": "2026-10-26",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": "./web-dist",
		"binding": "ASSETS",
		"html_handling": "none",
		"run_worker_first": [
			"/api/*",
			"/"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "edu-status-v2",
			"database_id": "197fa854-b5c7-4d4d-a145-66ddac81519a",
			"remote": false
		}
	],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 0.1
	},
	"kv_namespaces": [
		{
			"binding": "FILES_KV",
			"id": "b6adfe7c4cae4366aa913f78356bbc6f",
			"remote": false
		}
	]
}
