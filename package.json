{
  "private": true,
  "engines": {"node": ">=24.0.0"},
  "scripts": {
    "start": "node server/local.mjs",
    "init:demo": "node scripts/init-edu-demo.mjs",
    "build": "node scripts/build-edu.mjs",
    "build:pages": "node scripts/build-pages-bridge.mjs",
    "check": "node scripts/check-edu.mjs",
    "test": "node --test tests/*.test.cjs tests/*.test.mjs",
    "cf:types": "wrangler types worker-configuration.d.ts --include-runtime false",
    "cf:dev": "npm run build && wrangler dev --local --ip 127.0.0.1",
    "cf:schema:local": "wrangler d1 execute DB --local --file server/schema.sql",
    "seed:sql": "node scripts/prepare-edu-sql.mjs",
    "deploy:dry-run": "npm run build && wrangler deploy --dry-run --outdir .verification/worker-dry-run",
    "deploy": "npm run build && node scripts/prepare-edu-secrets.mjs && wrangler deploy --secrets-file .dev.vars.production.json",
    "build:pdf": "node scripts/build-pdf-engine.mjs",
    "convert": "node 수료증_엑셀일괄변환.mjs"
  },
  "dependencies": {
    "pdfjs-dist": "6.3.289"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261026.1",
    "agent-browser": "0.37.1",
    "esbuild": "0.28.2",
    "wrangler": "^4.152.0"
  }
}
